{
  "name": "@efed/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos compartilhados entre API e web: papéis, permissões, schemas e tipos",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@efed/config": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
