# Gerado a partir deste modelo na inicialização do contêiner (envsubst): ${PUBLIC_HOSTNAME}.

upstream efed_web {
  server web:3000;
  keepalive 16;
}

upstream efed_api {
  server api:3001;
  keepalive 16;
}

# HTTP: verificação de saúde, desafio ACME e redirecionamento para HTTPS.
server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  location /.well-known/acme-challenge/ {
    root /var/www/acme;
  }

  location / {
    return 301 https://${PUBLIC_HOSTNAME}$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PUBLIC_HOSTNAME};

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # O endereço do cliente é sempre o visto pelo Nginx: valores enviados pelo cliente são descartados.
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_read_timeout 30s;

  # Rotas sensíveis de autenticação: limite adicional por IP.
  location ~ ^/api/v1/auth/(login|register|password/|verify-email|mfa/) {
    limit_req zone=auth burst=20 nodelay;
    proxy_pass http://efed_api;
  }

  # A documentação interativa e o contrato OpenAPI não são publicados em produção.
  location /api/docs {
    return 404;
  }

  location /api/ {
    proxy_pass http://efed_api;
  }

  location / {
    proxy_pass http://efed_web;
  }
}
