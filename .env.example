# =============================================================================
# Federação eFootball 1x1 — variáveis de ambiente
#
# Copie para `.env` e ajuste. O `.env` nunca é versionado.
# Os valores abaixo servem SOMENTE para desenvolvimento local: a API se recusa a
# iniciar em produção enquanto um segredo contiver "change-me" ou "dev-only".
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------- 
# Portas publicadas na sua máquina (docker-compose.dev.yml), sempre em 127.0.0.1
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=efed
POSTGRES_USER=efed
POSTGRES_PASSWORD=dev-only-change-me-postgres
DATABASE_URL=postgresql://efed:dev-only-change-me-postgres@127.0.0.1:5432/efed?schema=public

# -----------------------------------------------------------------------------
# Redis (limite de requisições agora; filas BullMQ a partir da Fase 4)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=dev-only-change-me-redis
REDIS_URL=redis://:dev-only-change-me-redis@127.0.0.1:6379

# -----------------------------------------------------------------------------
# MinIO / S3 (avatares, escudos e evidências; o readiness da API confere se está no ar)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=efed
MINIO_ROOT_PASSWORD=dev-only-change-me-minio
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=efed
# A API cria o bucket na subida. Em produção, prefira um usuário do MinIO só para a API.
S3_ACCESS_KEY=efed
S3_SECRET_KEY=dev-only-change-me-minio

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Proxies reversos confiáveis à frente da API (0 em desenvolvimento, 1 atrás do Nginx).
TRUST_PROXY_HOPS=0
# Documentação interativa em /api/docs. Mantenha false em produção.
OPENAPI_ENABLED=true

# Origens do frontend autorizadas a chamar a API com credenciais (separadas por vírgula).
ALLOWED_ORIGINS=http://localhost:3000
# URL pública do frontend, usada nos links enviados por e-mail.
PUBLIC_WEB_URL=http://localhost:3000

# Sessões
SESSION_IDLE_TTL_MINUTES=10080
SESSION_ABSOLUTE_TTL_DAYS=30
ADMIN_SESSION_IDLE_TTL_MINUTES=120

# Segredos — gere valores novos para cada ambiente:
#   CSRF_SECRET:         openssl rand -base64 48
#   MFA_ENCRYPTION_KEY:  openssl rand -base64 32   (exatamente 32 bytes)
CSRF_SECRET=dev-only-change-me-csrf-secret-0123456789abcdef
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLW1mYS1rZXktMzJieXQ=

# Limites de requisições por IP, por minuto
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# -----------------------------------------------------------------------------
# E-mail (em desenvolvimento, o Mailpit captura tudo em http://localhost:8025)
# -----------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Federação eFootball <nao-responda@federacao.local>"

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
# Endereço da API visto pelo servidor do Next.js (rewrites e Server Components).
API_INTERNAL_URL=http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# Produção (docker-compose.yml)
# -----------------------------------------------------------------------------
# Domínio público servido pelo proxy reverso e portas publicadas no host.
PUBLIC_HOSTNAME=federacao.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Backups do PostgreSQL (serviço `backup`)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
